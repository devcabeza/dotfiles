# Dunst - Catppuccin Mocha
[global]
    frame_color = "#cba6f7"
    separator_color = frame
    font = "JetBrainsMono Nerd Font 10"
    corner_radius = 10
    offset = "12x12"
    origin = "top-right"
    transparency = 10
    gap_size = 6
    padding = 12
    horizontal_padding = 14

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#cba6f7"

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#f38ba8"

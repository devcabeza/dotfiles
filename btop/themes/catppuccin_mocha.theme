# Catppuccin Mocha theme for btop
# Main background, empty for terminal default (transparency)
theme[main_bg]="#1e1e2e"

# Main text color
theme[main_fg]="#cdd6f4"

# Title color for boxes
theme[title]="#cdd6f4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#89b4fa"

# Background color of selected item in lists
theme[selected_bg]="#313244"

# Foreground color of selected item in lists
theme[selected_fg]="#cdd6f4"

# Color of inactive/disabled text
theme[inactive_fg]="#6c7086"

# Color of text appearing on top of graphs
theme[graph_text]="#f5e0dc"

# Background color of the percentage meters
theme[meter_bg]="#313244"

# Misc colors for processes box
theme[proc_misc]="#f5e0dc"

# Cpu box outline color
theme[cpu_box]="#cba6f7"

# Memory/disks box outline color
theme[mem_box]="#a6e3a1"

# Net box outline color
theme[net_box]="#fab387"

# Processes box outline color
theme[proc_box]="#89b4fa"

# Box divider line and small boxes line color
theme[div_line]="#313244"

# Temperature graph colors
theme[temp_start]="#89b4fa"
theme[temp_mid]="#f9e2af"
theme[temp_end]="#f38ba8"

# CPU graph colors
theme[cpu_start]="#89b4fa"
theme[cpu_mid]="#cba6f7"
theme[cpu_end]="#f38ba8"

# Mem colors
theme[free_start]="#a6e3a1"
theme[free_mid]="#94e2d5"
theme[free_end]="#89dceb"

theme[cached_start]="#89dceb"
theme[cached_mid]="#74c7ec"
theme[cached_end]="#89b4fa"

theme[available_start]="#fab387"
theme[available_mid]="#f9e2af"
theme[available_end]="#a6e3a1"

theme[used_start]="#f38ba8"
theme[used_mid]="#eba0ac"
theme[used_end]="#fab387"

# Download graph colors
theme[download_start]="#89dceb"
theme[download_mid]="#74c7ec"
theme[download_end]="#89b4fa"

# Upload graph colors
theme[upload_start]="#fab387"
theme[upload_mid]="#f9e2af"
theme[upload_end]="#a6e3a1"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#89b4fa"
theme[process_mid]="#cba6f7"
theme[process_end]="#f38ba8"
